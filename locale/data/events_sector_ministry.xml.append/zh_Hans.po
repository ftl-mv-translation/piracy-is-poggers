#: src-en/data/events_sector_ministry.xml.append:22
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_FIGHTER_MONK\"]/mod:findWithChildLike/mod:selector"
msgstr "看看是否有打折中的奴隶。"

#: src-en/data/events_sector_ministry.xml.append:25
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_FIGHTER_MONK\"]/mod:findWithChildLike/mod:findLike/mod:findWithChildLike/mod:selector"
msgstr "购买这名超能族战士。"

#: src-en/data/events_sector_ministry.xml.append:39
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_FIGHTER_MONK\"]/mod:findWithChildLike/mod:findLike/mod-"
"append:choice/text"
msgstr "（奴隶贩子声望2+）请求查看那名超能族战士。"

#: src-en/data/events_sector_ministry.xml.append:41
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_FIGHTER_MONK\"]/mod:findWithChildLike/mod:findLike/mod-"
"append:choice/event/text"
msgstr "“哦，是你们啊。嗯，这有点尴尬，我刚才正想骗你们买这个奴隶呢。眼前这个以前是训练有素的超能族战士，但现在成了和平主义的信道者。好吧，既然话都说到这个份上了，我们仍然以更便宜的价格出售这个信道者，他们大概能在其他方面派上用场……”"

#: src-en/data/events_sector_ministry.xml.append:43
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_FIGHTER_MONK\"]/mod:findWithChildLike/mod:findLike/mod-"
"append:choice/event/choice[1]/text"
msgstr "购买那名信道者。"

#: src-en/data/events_sector_ministry.xml.append:45
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_FIGHTER_MONK\"]/mod:findWithChildLike/mod:findLike/mod-"
"append:choice/event/choice[1]/event/text"
msgstr "奴隶贩子把那名信道者传送过来，向你告别。他们离开后，你转身与你最新的船员聊天，他解释道：“我曾经是一名训练有素的超能族战士，但最终看到了光明，加入了信道者团体，但不久后就被这些人绑架了。你把我从奴隶制中解救出来，我现在将为你服务。虽然这听起来很讽刺。”"

#: src-en/data/events_sector_ministry.xml.append:51
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_FIGHTER_MONK\"]/mod:findWithChildLike/mod:findLike/mod-"
"append:choice/event/choice[1]/event/choice/text"
msgstr "继续。"

#: src-en/data/events_sector_ministry.xml.append:57
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_FIGHTER_MONK\"]/mod:findWithChildLike/mod:findLike/mod-"
"append:choice/event/choice[2]/text"
msgstr "拒绝。"

#: src-en/data/events_sector_ministry.xml.append:68
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_QUEST_LAWBOOK_PIRATE\"]/mod:findWithChildLike[1]/mod:selector"
msgstr "支付法律手册的费用。"

#: src-en/data/events_sector_ministry.xml.append:78
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_QUEST_LAWBOOK_PIRATE\"]/mod:findWithChildLike[2]/mod:selector"
msgstr "直接交战夺回。"

#: src-en/data/events_sector_ministry.xml.append:88
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_QUEST_LAWBOOK_PIRATE\"]/mod:findWithChildLike[3]/mod:selector"
msgstr "离开。"

#: src-en/data/events_sector_ministry.xml.append:91
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_QUEST_LAWBOOK_PIRATE\"]/mod:findWithChildLike[3]/mod:findLike/mod:findWithChildLike[1]/mod:selector"
msgstr "支付法律手册的费用。"

#: src-en/data/events_sector_ministry.xml.append:101
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_QUEST_LAWBOOK_PIRATE\"]/mod:findWithChildLike[3]/mod:findLike/mod:findWithChildLike[2]/mod:selector"
msgstr "直接交战夺回。"

#: src-en/data/events_sector_ministry.xml.append:113
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_QUEST_LAWBOOK_PIRATE\"]/mod-"
"append:choice/text"
msgstr "（走私者声望2+）礼貌地索要那本书。"

#: src-en/data/events_sector_ministry.xml.append:115
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_QUEST_LAWBOOK_PIRATE\"]/mod-"
"append:choice/event/text"
msgstr "“啊，原来是你！嗯……说实话，我也不觉得我们能靠这堆破烂赚到什么大钱。你拿去吧。”"

#: src-en/data/events_sector_ministry.xml.append:117
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"ZOLTAN_QUEST_LAWBOOK_PIRATE\"]/mod-"
"append:choice/event/choice/text"
msgstr "感谢那些走私者。"

#: src-en/data/events_sector_ministry.xml.append:152
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"DISTRESS_ZOLTAN_ARREST\"]/mod:findWithChildLike/mod:selector"
msgstr "向超能族汇报这些海盗。"

#: src-en/data/events_sector_ministry.xml.append:155
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"DISTRESS_ZOLTAN_ARREST\"]/mod:findWithChildLike/mod:findLike/mod-"
"append:choice/text"
msgstr "继续。"

#: src-en/data/events_sector_ministry.xml.append:164
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"DISTRESS_CAPITAL_ARREST_WIN\"]/mod:findWithChildLike[1]/mod:selector"
msgstr "看来这些海盗是一群奴贩。由于感谢你的帮助，他们免费提供给你一个他们的\"工人\"。"

#: src-en/data/events_sector_ministry.xml.append:166
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"DISTRESS_CAPITAL_ARREST_WIN\"]/mod:findWithChildLike[1]/mod-"
"append:choice/text"
msgstr "继续。"

#: src-en/data/events_sector_ministry.xml.append:171
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"DISTRESS_CAPITAL_ARREST_WIN\"]/mod:findWithChildLike[2]/mod:selector"
msgstr "这些海盗似乎是雇佣兵，具有讽刺意味的是，他们被叛军雇佣来追捕你。在一阵尴尬的沉默之后，你们达成了交易，他们承诺向叛军舰队撒谎。"

#: src-en/data/events_sector_ministry.xml.append:173
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"DISTRESS_CAPITAL_ARREST_WIN\"]/mod:findWithChildLike[2]/mod-"
"append:choice/text"
msgstr "继续。"

#: src-en/data/events_sector_ministry.xml.append:178
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"DISTRESS_CAPITAL_ARREST_WIN\"]/mod:findWithChildLike[3]/mod:selector"
msgstr "这些海盗似乎是走私者。他们解释说，他们的客户告发了他们，导致他们被捕。现在你救了他们，他们提出要把东西卖给你。"

#: src-en/data/events_sector_ministry.xml.append:183
msgid ""
"data/events_sector_ministry.xml.append$//mod:findName[@name=\"DISTRESS_CAPITAL_ARREST_WIN\"]/mod:findWithChildLike[3]/mod-"
"append:choice/text"
msgstr "继续。"
