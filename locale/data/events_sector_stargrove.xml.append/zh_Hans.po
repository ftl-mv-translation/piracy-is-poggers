#: src-en/data/events_sector_stargrove.xml.append:5
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"STARGROVE_HIGHWAYMAN_INITIAL\"]/mod-"
"append:choice/text"
msgstr "（海盗声望2+）提醒拦路海盗你良好的声望。"

#: src-en/data/events_sector_stargrove.xml.append:7
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"STARGROVE_HIGHWAYMAN_INITIAL\"]/mod-"
"append:choice/event/text"
msgstr ""
"你告诉那名海盗，你曾多次帮助过海盗。\n"
"\n"
"“哼，你确实帮过我的一些朋友，这没错。我敬重你。既然如此，我给你我的朋友专属折扣。还是说你想来硬的？”"

#: src-en/data/events_sector_stargrove.xml.append:11
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"STARGROVE_HIGHWAYMAN_INITIAL\"]/mod-"
"append:choice/event/choice[1]/text"
msgstr "付钱。"

#: src-en/data/events_sector_stargrove.xml.append:13
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"STARGROVE_HIGHWAYMAN_INITIAL\"]/mod-"
"append:choice/event/choice[1]/event/text"
msgstr "海盗从你这里收了通行费，微微皱了皱眉。“走吧，变元者。我们还要搞升级呢。”"

#: src-en/data/events_sector_stargrove.xml.append:20
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"STARGROVE_HIGHWAYMAN_INITIAL\"]/mod-"
"append:choice/event/choice[@req=\"loc_scrap\"]/text"
msgstr "我们连40~都拿不出来。能换个别的条件吗？"

#: src-en/data/events_sector_stargrove.xml.append:24
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"STARGROVE_HIGHWAYMAN_INITIAL\"]/mod-"
"append:choice/event/choice[3]/text"
msgstr "这个条件还是无法接受。"

#: src-en/data/events_sector_stargrove.xml.append:33
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"NEBULA_LIGHT_STARGROVE_SMUGGLER_STORE\"]/mod:findWithChildLike[1]/mod:selector"
msgstr "攻击雇佣兵。"

#: src-en/data/events_sector_stargrove.xml.append:43
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"NEBULA_LIGHT_STARGROVE_SMUGGLER_STORE\"]/mod:findWithChildLike[2]/mod:selector"
msgstr "避开那些海盗。"

#: src-en/data/events_sector_stargrove.xml.append:47
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"NEBULA_LIGHT_STARGROVE_SMUGGLER_STORE\"]/mod-"
"append:choice[1]/text"
msgstr "（佣兵声望2+）请那名佣兵放过走私者。"

#: src-en/data/events_sector_stargrove.xml.append:49
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"NEBULA_LIGHT_STARGROVE_SMUGGLER_STORE\"]/mod-"
"append:choice[1]/event/text"
msgstr "那名佣兵起初对放弃追捕有些犹豫，但最终还是让步了。“哼，好吧。我虽然很想杀了这些走私的混蛋，但同样不想惹恼一位忠实客户，而且我们反正也需要补充燃料。”他们转身面向走私者。“别以为这事儿就完了。等我们加完油，等变元者用完了你们的服务，我们马上就会回来咬住你们。”佣兵跃迁离开了。"

#: src-en/data/events_sector_stargrove.xml.append:51
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"NEBULA_LIGHT_STARGROVE_SMUGGLER_STORE\"]/mod-"
"append:choice[1]/event/choice/text"
msgstr "联系那个走私者。"

#: src-en/data/events_sector_stargrove.xml.append:57
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"NEBULA_LIGHT_STARGROVE_SMUGGLER_STORE\"]/mod-"
"append:choice[2]/text"
msgstr "避开那些海盗。"

#: src-en/data/events_sector_stargrove.xml.append:59
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"NEBULA_LIGHT_STARGROVE_SMUGGLER_STORE\"]/mod-"
"append:choice[2]/event/text"
msgstr "当你准备离开时，那两艘船继续在星空中缠斗。"

#: src-en/data/events_sector_stargrove.xml.append:61
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"NEBULA_LIGHT_STARGROVE_SMUGGLER_STORE\"]/mod-"
"append:choice[2]/event/choice[1]/text"
msgstr "星舰管理。"

#: src-en/data/events_sector_stargrove.xml.append:65
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"NEBULA_LIGHT_STARGROVE_SMUGGLER_STORE\"]/mod-"
"append:choice[2]/event/choice[2]/text"
msgstr "跳过。"

#: src-en/data/events_sector_stargrove.xml.append:74
msgid ""
"data/events_sector_stargrove.xml.append$//mod:findName[@name=\"STARGROVE_SMUGGLER_STORE\"]/mod-"
"append:choice/text"
msgstr "继续。"
